{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Herbertofury/Athena/blob/main/guidance/schemas/game-system-package.schema.json",
  "title": "Game System Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "owner",
    "license",
    "contractVersion",
    "capabilities",
    "hostRequirements",
    "dependencies",
    "permissions",
    "dataOwnership",
    "migrations",
    "testEvidence",
    "consumers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "kind": {
      "enum": [
        "shared-gameplay",
        "card-game",
        "roguelike",
        "encounter-content",
        "presentation"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "content",
        "assets"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "string",
          "minLength": 1
        },
        "thirdParty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^gameplay\\.[a-z0-9.-]+$"
      }
    },
    "hostRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "runtime"
        ],
        "properties": {
          "runtime": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "versionRange"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "versionRange": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dataOwnership": {
      "enum": [
        "host-owned",
        "package-owned",
        "user-owned",
        "mixed-explicit"
      ]
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "commandOrEntry"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "commandOrEntry": {
            "type": "string"
          },
          "reversible": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "testEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "evidenceLevel"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "evidenceLevel": {
            "enum": [
              "synthetic",
              "fixture",
              "native-runtime",
              "consumer-accepted"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "version",
          "status"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "candidate",
              "testing",
              "accepted",
              "held",
              "retired"
            ]
          },
          "evidence": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced host-specific data; must not override the common contract."
    }
  }
}
