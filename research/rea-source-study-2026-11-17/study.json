  "claims": [
    {
      "id": "shared-cli-mcp-composition",
      "finding": "CLI/MCP binary sessions share provider-selection and evidence semantics at one composition point.",
      "classification": "source-observed",
      "source_paths": [
        "src/composition/binary.ts"
      ],
      "athena_application": "Give Athena one domain service behind UI, CLI and Hermes adapters; test matching errors and cancellation across adapters.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "progressive-catalog",
      "finding": "Cold tool visibility changes only after the discovery response fits its budget; excluded families cannot be re-enabled by discovery.",
      "classification": "source-observed",
      "source_paths": [
        "src/server/ProgressiveToolCatalog.ts",
        "src/contracts/catalog/catalogDiscovery.ts"
      ],
      "athena_application": "Use scoped on-demand schemas for Athena agents; benchmark actual tokens and task quality rather than claiming free usage.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "lazy-providers",
      "finding": "Provider metadata is available before implementation load; a rejected load clears the cached promise for retry.",
      "classification": "source-observed",
      "source_paths": [
        "src/application/binary/LazyAnalysisProvider.ts"
      ],
      "athena_application": "Keep database browsing cheap; load analysis engines only when an authorized job needs them.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "bounded-ledger",
      "finding": "Ledger validates sealed evidence, returns duplicate on identical semantic IDs, and budgets retained representation before committing.",
      "classification": "source-observed",
      "source_paths": [
        "src/application/investigation/EvidenceLedger.ts"
      ],
      "athena_application": "Deduplicate by semantic identity and bind analysis to target digest, provider/version and parameters, not filenames alone.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "unknowns-first-class",
      "finding": "Residual unknowns include revision digests, relationships, required authority/confidence/environment and evidence-qualified resolution.",
      "classification": "source-observed",
      "source_paths": [
        "src/domain/residualUnknown.ts",
        "src/application/investigation/EvidenceLedger.residualUnknown.test.ts"
      ],
      "athena_application": "Store unresolved questions alongside findings; do not convert an untested hypothesis into curriculum fact or parity completion.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "partial-outcome-retention",
      "finding": "Partial-result delivery tests distinguish retained, unretained and unknown-retention evidence after later errors.",
      "classification": "source-observed",
      "source_paths": [
        "src/server/ToolResultDelivery.partialRetention.test.ts",
        "src/server/externalMutationAdmission.ts"
      ],
      "athena_application": "Athena job history should preserve completed effects after cancel/failure and avoid blind retries.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "process-identity",
      "finding": "Ownership evidence separates process generation identity, run tokens and unresolved relations; host table coverage remains unreported.",
      "classification": "source-observed",
      "source_paths": [
        "src/process/ProcessOwnershipEvidence.ts"
      ],
      "athena_application": "Do not kill a reused PID or infer complete process coverage from a snapshot.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "static-runtime-separation",
      "finding": "Runtime reconciliation resolves and validates static/runtime evidence identities; docs limit observations to observed versions and environments.",
      "classification": "source-observed",
      "source_paths": [
        "src/application/javascript/JavaScriptRuntimeReconciliationService.ts",
        "docs/guides/javascript/javascript-application-workflows.md"
      ],
      "athena_application": "Browser parity needs actual code evidence plus reproducible runtime cases; matching screenshots or a source graph is insufficient.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "scoped-reconstruction",
      "finding": "An overall structural-function claim includes its constituent dimensions and active scoped unknowns; correlation is not causality.",
      "classification": "source-observed",
      "source_paths": [
        "docs/reference/mcp-contracts.md"
      ],
      "athena_application": "Mod semantic changelogs and parity reports need per-dimension completeness and unresolved-field reporting.",
      "application_status": "proposed-not-implemented"
    },
    {
      "id": "license-boundary",
      "finding": "REA is MIT, but dependency/engine notices identify separate licenses and recorded notice gaps.",
      "classification": "source-observed",
      "source_paths": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
      ],
      "athena_application": "Track REA, external engines and analyzed artifacts as separate license/provenance records; no blanket rights inheritance.",
      "application_status": "proposed-not-implemented"
    }
  ],
