{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Herbertofury/Athena/blob/main/data/software/schema.json",
  "title": "Athena sourced software partition",
  "type": "object",
  "required": [
    "schema_version",
    "reviewed_at",
    "applications"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "family",
          "category",
          "summary",
          "license",
          "evidence_status",
          "official_url",
          "download_url",
          "repository_url",
          "features",
          "strengths",
          "limitations",
          "use_cases",
          "tags",
          "platforms",
          "license_kind",
          "pricing_model",
          "alternatives",
          "recommendation",
          "maintenance",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "system",
              "files",
              "security",
              "networking",
              "productivity",
              "creative",
              "development",
              "ai",
              "gaming",
              "science"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "type": "string",
            "minLength": 1
          },
          "official_url": {
            "type": "string",
            "format": "uri"
          },
          "download_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "repository_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "strengths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "use_cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Windows",
                "macOS",
                "Linux",
                "Web",
                "FreeBSD",
                "Bootable"
              ]
            }
          },
          "license_kind": {
            "enum": [
              "open-source",
              "source-available",
              "proprietary",
              "mixed",
              "unknown"
            ]
          },
          "pricing_model": {
            "enum": [
              "free",
              "freemium",
              "paid",
              "subscription",
              "mixed",
              "unknown"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platform_notes": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "object",
            "required": [
              "pick_for",
              "compare_when"
            ],
            "properties": {
              "pick_for": {
                "type": "string",
                "minLength": 1
              },
              "compare_when": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "maintenance": {
            "type": "object",
            "required": [
              "status",
              "checked_at",
              "note",
              "source_url"
            ],
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "archived",
                  "discontinued",
                  "unverified"
                ]
              },
              "checked_at": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "label",
                "checked_at",
                "supports"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "checked_at": {
                  "type": "string",
                  "format": "date"
                },
                "supports": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "identity",
                      "features",
                      "license",
                      "platforms",
                      "pricing",
                      "downloads",
                      "maintenance"
                    ]
                  }
                }
              }
            }
          },
          "pricing_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
