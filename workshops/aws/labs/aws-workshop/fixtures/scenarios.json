          "no_host_management",
          "container_image"
        ],
        "caveats": [
          "Validate runtime, duration, concurrency, payload and cold-start constraints."
        ]
      },
      {
        "id": "managed-container-shaped",
        "capabilities": [
          "event_triggered",
          "no_host_management",
          "container_image",
          "long_lived_process"
        ],
        "caveats": [
          "Event integration and orchestration must be designed; no automatic service equivalence."
        ]
      },
      {
        "id": "vm-shaped",
